            <CityResultRow
              key={city.id}
              city={city}
              onAdd={onAddToTrip}
              onSave={(c) => saveMutation.mutate(c.id)}
              saving={saveMutation.isPending && saveMutation.variables === city.id}
            />
          ))
        )}
      </div>
    </div>
  );
}
