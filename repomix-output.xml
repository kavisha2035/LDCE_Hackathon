  ArrowLeft, RefreshCw, Calendar, MapPin, BedDouble, Plane,
  Ticket, CheckCircle2, ChevronRight, Sliders, Info
} from 'lucide-react';

export default function TripBudgetPage({ tripId, onBack, onNavigateToCalendar }) {
  const [trips, setTrips] = useState([]);
  const [selectedTripId, setSelectedTripId] = useState(tripId || null);
  const [budgetData, setBudgetData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  // User-configurable budget threshold (per day or total)
  const [budgetLimit, setBudgetLimit] = useState(2000);
  const [perStopLimit, setPerStopLimit] = useState(900);
  const [showLimitConfig, setShowLimitConfig] = useState(false);

  // Active chart tab (overview, by-stop, by-category)
  const [activeView, setActiveView] = useState('all'); // 'all', 'stops', 'categories'

  // Fetch all trips for switcher if no tripId or to allow switching
  useEffect(() => {
    fetch('/api/trips')
      .then(res => res.json())
      .then(data => {
        const list = data.trips || [];
        setTrips(list);
        if (!selectedTripId && list.length > 0) {
          setSelectedTripId(list[0].id);
