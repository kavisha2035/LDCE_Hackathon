// Prisma schema for GlobeTrotter Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Initial placeholder schema model to verify Prisma connection
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
